# Service; defaults are loopback-only. Public cloud instances must sit behind TLS.
AGENTRECALL_ROLE=local
AGENTRECALL_BIND_ADDR=127.0.0.1:8789
AGENTRECALL_DATABASE_PATH=./data/agentrecall.duckdb
AGENTRECALL_TOKENS_FILE=./config/tokens.json
# Persist this ID or omit on first startup so DuckDB creates and stores one.
AGENTRECALL_REPLICA_ID=
AGENTRECALL_ALLOWED_HOSTS=localhost,127.0.0.1,::1
# Empty means browser Origin headers are rejected; machine clients may omit Origin.
AGENTRECALL_ALLOWED_ORIGINS=
AGENTRECALL_CURSOR_HMAC_SECRET=replace-with-at-least-32-random-bytes
# Set both only during a bounded cursor-key rotation; see docs/operations.md.
# AGENTRECALL_CURSOR_HMAC_PREVIOUS_SECRET=replace-with-previous-secret
# AGENTRECALL_CURSOR_HMAC_PREVIOUS_UNTIL=<RFC3339-UTC-deadline>
AGENTRECALL_QUOTA_PER_OWNER=10000

# Optional local/in-process semantic embeddings; omit to remain lexical-only.
# First startup downloads the pinned BGE-M3 ONNX model into this cache directory.
AGENTRECALL_EMBEDDING_PROVIDER=bge-m3
AGENTRECALL_EMBEDDING_CACHE_DIR=./data/models

# Set both only on an instance that accepts replication requests (normally cloud).
AGENTRECALL_REPLICATION_TOKEN=replace-with-a-separate-service-to-service-secret
AGENTRECALL_TRUSTED_REPLICA_ID=local-stable-replica-id

# Configure all three on the local instance to initiate sync to the cloud.
AGENTRECALL_PEER_URL=https://memory.example.net/_internal/replication/exchange
AGENTRECALL_PEER_TOKEN=replace-with-cloud-replication-credential
AGENTRECALL_PEER_REPLICA_ID=cloud-stable-replica-id

# Optional Hermes local-first router (run `agentrecall serve-router` separately).
AGENTRECALL_ROUTER_BIND_ADDR=127.0.0.1:8788
AGENTRECALL_ROUTER_LOCAL_URL=http://127.0.0.1:8789/mcp
# Optional: set both cloud variables to enable confirmed-connect-error fallback.
# AGENTRECALL_ROUTER_CLOUD_URL=https://memory.example.net/mcp
AGENTRECALL_ROUTER_HERMES_TOKEN=replace-with-a-random-router-ingress-secret
AGENTRECALL_ROUTER_LOCAL_SERVICE_TOKEN=replace-with-local-MCP-token
# AGENTRECALL_ROUTER_CLOUD_SERVICE_TOKEN=replace-with-cloud-fallback-MCP-token
AGENTRECALL_ROUTER_ALLOWED_ORIGINS=

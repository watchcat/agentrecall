# Copy this file to .env and chmod 600 .env. Never commit the real .env.
# Literal KEY=VALUE format. Optional surrounding quotes are removed, but values
# are NOT shell-expanded. No inline comments, escapes or multiline values.
# This is the cloud-deploy example; .env.example documents local runtime options.
AGENTRECALL_SSH=root@169.58.231.116
AGENTRECALL_DOMAIN=memory.all-your-base.net

# Lexical stays the default. Semantic requires a separate explicit provisioning
# operation first; --profile overrides this setting for a single command.
AGENTRECALL_PROFILE=lexical

# Default deploy reuses an image already imported into k3s containerd.
AGENTRECALL_IMAGE=agentrecall:native-31e715e-9b868aa001ba
# CRI/config digest, NOT the OCI index/manifest digest.
AGENTRECALL_IMAGE_CONFIG_DIGEST=sha256:40a36a38b3baac23d7f78c87e68a397d127015d750cad9b361c3deb98999716b
# For --build choose a NEW image tag and clear/update the expected digest above.

# Persist these values. Changing an existing deployment's identity or secrets
# is deliberately refused; use a separately reviewed rotation procedure.
AGENTRECALL_REPLICA_ID=replace-with-persistent-cloud-replica-id
AGENTRECALL_MCP_TOKEN=replace-with-at-least-32-random-characters
AGENTRECALL_CURSOR_HMAC_SECRET=replace-with-at-least-32-random-characters
AGENTRECALL_OWNER_ID=deployment-test
AGENTRECALL_CLIENT_ID=cloud-test
AGENTRECALL_NAMESPACES=shared
AGENTRECALL_SCOPES=memory:read,memory:write,memory:delete

# Existing Ready ClusterIssuer; the script does not create/modify an issuer.
AGENTRECALL_CLUSTER_ISSUER=letsencrypt
# Optional installed trusted CA bundle for clients with a stale default store.
# Example on this Mac: python3 -c 'import certifi; print(certifi.where())'
AGENTRECALL_CA_BUNDLE=

# Do not set AGENTRECALL_EMBEDDING_* here: the explicit semantic profile owns
# provider=bge-m3 and the dedicated read-only /models cache mount.
# Optional receiver-only pairing: both settings or neither. Use a NEW random
# bearer distinct from MCP/cursor/router secrets, and the actual local replica ID.
# Initial enable adds one exact HTTPS exchange route and a dedicated Secret;
# existing pairing secrets/identities cannot be implicitly changed or removed.
# This trusts the whole replica, including all owners/namespaces, not only shared.
AGENTRECALL_REPLICATION_TOKEN=
AGENTRECALL_TRUSTED_REPLICA_ID=

# Optional separate cloud client with the same owner as local Hermes. Provision
# it additively before rollout; normal deploy refuses all credential differences.
# Token and owner together. Other defaults: client cue-cloud, namespace shared.
AGENTRECALL_CUE_MCP_TOKEN=
AGENTRECALL_CUE_OWNER_ID=
AGENTRECALL_CUE_CLIENT_ID=cue-cloud
AGENTRECALL_CUE_NAMESPACES=shared

# No SSH password or TLS private key is configured here.
# SSH uses your existing key/agent and known_hosts. cert-manager owns TLS keys.
